---
import MainLayout from '@/layouts/MainLayout.astro';
import Glyph from '@components/ui/Glyph.astro';
import { getCollection } from 'astro:content';
import { localePath } from '@utils/locale';

/**
 * The docs hub: pick a product, then open its docs. The sections are fixed
 * (start here, the chain, the products); the page links inside each one are
 * read from the docs collection, so the hub cannot drift when a page is added.
 */
const sections = [
  { id: 'guides', name: 'Start here', line: 'What Hyper 0x is, and how a first pilot begins.', icon: 'book-2' },
  { id: 'hyper-0x', name: 'Hyper 0x', line: 'The chain: consensus, encryption, private L2s, bridges and contracts.', icon: 'link-2' },
  { id: 'h0x-ade', name: 'H0x-ADE', line: 'The agentic development environment that checks every call an agent makes.', icon: 'safe-shield' },
  { id: 'hyper-wallet', name: 'Hyper Wallet & SDKs', line: 'The multi-chain wallet and exchange, and the SDKs that put it in your app.', icon: 'laptop' },
  { id: 'h0x-pay', name: 'H0X Pay', line: 'Payments that invest a slice of every payment.', icon: 'coin' },
];

const docs = await getCollection('docs');
const pagesOf = (section: string) =>
  docs
    .filter(entry => entry.id.startsWith(`${section}/`))
    .sort((a, b) => (a.data.sidebar.order ?? 0) - (b.data.sidebar.order ?? 0))
    .map(entry => ({ title: entry.data.title, href: localePath('en', `/${entry.id}/`) }));

const cards = sections.map(section => ({ ...section, pages: pagesOf(section.id) }));
---

<MainLayout title="Hyper 0x documentation" seoTitle="Hyper 0x Documentation: Chain and Product Docs" description="Hyper 0x documentation: pick the chain or a product, then open its guides. H0x-ADE, Hyper Wallet, and H0X Pay, all in one place." kind={{ type: 'CollectionPage' }}>
  <div class="mx-auto max-w-[85rem] px-4 pt-12 pb-16 sm:px-6 lg:px-8 lg:pt-16">
    <div class="mb-8 max-w-2xl md:mb-12">
      <h1 id="docs" class="text-4xl leading-[1.04] font-semibold text-ink sm:text-5xl">Hyper 0x documentation</h1>
      <p class="mt-4 max-w-[58ch] text-pretty text-muted">Guides for the Hyper 0x chain and every product on it. Pick one, then open its pages, whether you are evaluating the chain or building on it.</p>
    </div>

    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 md:gap-5 lg:grid-cols-3">
      {cards.map((card, index) => (
        <section class:list={['rounded-[1.6rem] bg-card p-6 ring-1 ring-line sm:p-7', index === 0 && 'lg:col-span-2']} aria-labelledby={card.id} data-reveal>
          <span class="grid size-12 place-items-center rounded-2xl bg-ink/5 text-ink"><Glyph icon={card.icon} class="size-6" /></span>
          <h3 id={card.id} class="mt-5 text-2xl font-semibold text-ink">{card.name}</h3>
          <p class="mt-1 text-pretty text-muted">{card.line}</p>
          <ul class="mt-5 space-y-2.5">
            {card.pages.map(page => (
              <li><a href={page.href} class="inline-flex items-center gap-1.5 font-medium text-ink transition hover:text-orange-700 dark:hover:text-orange-300">{page.title}<Glyph icon="arrow-right" class="size-4" /></a></li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>
</MainLayout>
