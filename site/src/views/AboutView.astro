---
import MainLayout from '@/layouts/MainLayout.astro';
import { Picture } from 'astro:assets';
import SectionHead from '@components/home/SectionHead.astro';
import FinalCta from '@components/home/FinalCta.astro';
import Box from '@components/home/Box.astro';
import Glyph from '@components/ui/Glyph.astro';
import IsoFigure from '@components/ui/IsoFigure.astro';
import PrimaryCTA from '@components/ui/buttons/PrimaryCTA.astro';
import founderPhoto from '@images/team/vijay.jpg';
import { ORGANIZATION } from '@data/constants';
import socialIcons from '@data/social-icons.json';
import { getCopy } from '@/copy';
import { localePath, type MarketingLocale } from '@utils/locale';

import { headingSlug } from '@utils/utils';
/**
 * About, in the running order of pavii.tech's about page (structure and rhythm
 * only): hero, why we started (a counted timeline), four fact tiles, the group
 * diagram with the three-layer text, mission / vision / goal, outcomes, the
 * team, short answers (also FAQPage data) and the closing call to action.
 * The fact tiles count how the product is built; they are not usage figures.
 * The team is the founder alone: every entry in src/data_files/team.ts is
 * marked mock, so none of it renders.
 */
interface Props {
  locale: MarketingLocale;
}

const { locale } = Astro.props;
const t = getCopy(locale);
const copy = t.about;
const statIcons = ['cube', 'robot', 'shield-check', 'link-simple'];
/**
 * Link text for each card, naming where the link goes (R10.4 bans "Learn more"
 * and other generic anchors). Keyed by the card's own title rather than by its
 * position: a positional list silently attaches the wrong text to every card
 * below an item that is reordered or inserted in the copy file, and nothing
 * fails. This is the same reason section 9.5 derives a heading id from its own
 * slug and never from an index. The fallback keeps a new card descriptive
 * rather than blank.
 */
const linkFor = (map: Record<string, string>, title: string) => map[title] ?? `Read about ${title.toLowerCase()}`;

const nowLinks: Record<string, string> = {
  'Checking AI agents': 'Read how the gate checks each call',
  'Stablecoin payments': 'See how H0x Pay settles payments',
  'Private L2 chains': 'See how a private L2 works',
  'Tools for builders and their AI agents': 'Start building with our SDKs',
};
const beyondLinks: Record<string, string> = {
  'Prove a fact, keep the data private': 'Read how to prove a fact privately',
  'Run one process across many companies': 'See custom chains for many companies',
  'Own a part of a large asset': 'See how asset tokenization works',
  'Audit without exposing everything': 'Read the four layers of encryption',
  'Rules that run before money moves': 'Read how compliance as code works',
  'AI agents that you can audit': 'See how agent receipts work',
};
const vision = t.home.vision;
const href = (url: string) => localePath(locale, url);
---

<MainLayout title={copy.title} seoTitle={copy.seoTitle} description={copy.metaDescription} kind={{ type: 'AboutPage' }} faqs={copy.faq.items}>
  <section class="mx-auto max-w-[85rem] px-4 pt-14 pb-14 sm:px-6 lg:px-8 lg:pt-20">
    <h1 id={headingSlug(`${copy.claim} ${copy.payoff}`)} class="scroll-mt-24 max-w-5xl text-[2.6rem] leading-[1] font-semibold text-ink sm:text-6xl lg:text-[3.6rem] xl:text-[4rem]">
      <span class="block">{copy.claim}</span>
      <span class="mark">{copy.payoff}</span>
    </h1>
    <p class="mt-7 max-w-[46rem] text-lg leading-relaxed text-pretty text-ink/80 sm:text-xl" data-reveal>{copy.lead}</p>
  </section>

  <section class="mx-auto max-w-[85rem] px-4 pb-20 sm:px-6 lg:px-8" aria-labelledby="story-title">
    <div class="glass-card grid grid-cols-1 gap-10 rounded-[2rem] p-6 sm:p-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16" data-story>
      <div class="lg:sticky lg:top-28 lg:self-start">
        <h2 id="story-title" class="text-3xl leading-tight font-semibold text-balance text-ink sm:text-4xl">{copy.story.title}</h2>
        <p class="mt-4 text-lg leading-relaxed text-pretty text-muted">{copy.story.intro}</p>
        {/* The stage: on large screens it follows the chapter you are reading. */}
        <div class="story-stage mt-10 hidden lg:block" aria-hidden="true">
          <div class="relative h-40">
            {copy.story.steps.map((step, index) => (
              <div class="story-chapter absolute inset-0" data-chapter={index} data-on={index === 0 ? '' : undefined}>
                <span class="grid size-14 place-items-center rounded-2xl bg-ink text-ground"><Glyph ui={step.icon} class="size-7" /></span>
                <p class="mt-5 text-4xl leading-tight font-semibold text-ink xl:text-5xl">{step.label}</p>
              </div>
            ))}
          </div>
          <div class="mt-6 flex gap-1.5">
            {copy.story.steps.map((_, index) => <span class="story-pip h-1 flex-1 rounded-full bg-line" data-pip={index}></span>)}
          </div>
        </div>
        <p class="mt-8 border-l-2 border-orange-500 pl-4 text-lg leading-relaxed text-pretty text-ink">{copy.story.belief}</p>
      </div>
      <ol class="story-steps relative grid gap-10 lg:gap-24 lg:py-10">
        {copy.story.steps.map((step, index) => (
          <li class="story-step relative grid grid-cols-[2.25rem_minmax(0,1fr)] gap-4" data-story-step={index}>
            <span class="story-dot relative z-[1] grid size-9 place-items-center rounded-full bg-ink text-ground"><Glyph ui={step.icon} class="size-4" /></span>
            <div class="pt-1">
              <h3 id={headingSlug(step.title)} class="scroll-mt-24 text-xl font-semibold text-balance text-ink sm:text-2xl">{step.title}</h3>
              <p class="mt-2 text-lg leading-relaxed text-pretty text-muted">{step.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
    <dl class="mt-3 grid grid-cols-2 gap-3 lg:grid-cols-4" data-reveal-group>
      {copy.stats.map((stat, index) => (
        <div class="glass-card rounded-[1.6rem] p-4 sm:p-6" data-reveal-item>
          <Glyph icon={statIcons[index]} class="size-6 text-ink sm:size-7" />
          <dt class="sr-only">{stat.label}</dt>
          <dd class="mt-4 font-display text-3xl font-semibold text-ink tabular-nums sm:mt-6 sm:text-4xl">{stat.value}</dd>
          <dd class="mt-1 text-sm text-muted">{stat.label}</dd>
        </div>
      ))}
    </dl>
    <p class="mt-3 text-sm text-muted" data-reveal>{copy.statsNote}</p>
  </section>

  <section class="mx-auto max-w-[85rem] px-4 pb-20 sm:px-6 lg:px-8" aria-labelledby="group-title">
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,6fr)_minmax(0,5fr)] lg:items-end lg:gap-16">
      <h2 id="group-title" class="text-4xl leading-[1.02] font-semibold text-ink sm:text-5xl" data-reveal><span class="block">{copy.group.claim}</span><span class="mark">{copy.group.payoff}</span></h2>
      <p class="text-lg leading-relaxed text-pretty text-muted" data-reveal>{copy.group.body}</p>
    </div>
    <IsoFigure name="group-bench" tone="card" />
    <dl class="mt-10 grid grid-cols-1 divide-y divide-line border-y border-line md:grid-cols-3 md:divide-x md:divide-y-0" data-reveal-group>
      {copy.group.layers.map(layer => (
        <div class="grid content-start gap-2 py-6 md:px-8 md:first:pl-0 md:last:pr-0" data-reveal-item>
          <dt class="font-display text-2xl font-semibold text-ink">{layer.term}</dt>
          <dd class="leading-relaxed text-pretty text-muted">{layer.detail}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="mx-auto max-w-[85rem] px-4 py-20 sm:px-6 lg:px-8 lg:py-28" aria-labelledby="pillars-title">
    <SectionHead claim={copy.pillars.claim} payoff={copy.pillars.payoff} id="pillars-title" />
    <ul class="mt-12 grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-4" data-reveal-group>
      {copy.pillars.items.map(item => {
        const moat = item.label === 'Moat';
        return (
          <li class:list={['flex flex-col rounded-[1.8rem] p-6 sm:p-7', moat ? 'on-sheet bg-sheet text-white' : 'glass-card']} data-reveal-item>
            <h3 id={headingSlug(item.title)} class:list={['scroll-mt-24 text-2xl leading-tight font-semibold text-balance', moat ? 'text-white' : 'text-ink']}>{item.title}</h3>
            <p class:list={['mt-3 leading-relaxed text-pretty', moat ? 'text-white/75' : 'text-muted']}>{item.text}</p>
          </li>
        );
      })}
    </ul>
  </section>

  <section class="mx-auto max-w-[85rem] px-4 pb-20 sm:px-6 lg:px-8" aria-labelledby="now-title">
    <SectionHead claim={copy.now.claim} payoff={copy.now.payoff} body={copy.now.body} id="now-title" />
    <ul class="mt-12 grid grid-cols-1 gap-3 md:grid-cols-2 lg:grid-cols-3" data-reveal-group>
      {copy.now.items.map((item, index) => {
        const lead = index === 0;
        return (
          <li class:list={[lead && 'lg:col-span-2', index === copy.now.items.length - 1 && 'md:col-span-2']} data-reveal-item>
            <a href={href(item.url)} class:list={['now-card group flex h-full flex-col rounded-[1.8rem] p-6 sm:p-7', lead ? 'on-sheet bg-sheet text-white' : 'glass-card']}>
              <span class:list={['grid place-items-center rounded-2xl transition duration-300', lead ? 'size-14 bg-white/10 text-white' : 'size-12 bg-card text-ink ring-1 ring-line group-hover:bg-ink group-hover:text-ground group-hover:ring-ink']}><Glyph ui={item.icon} class={lead ? 'size-7' : 'size-6'} /></span>
              <h3 id={headingSlug(item.title)} class:list={['scroll-mt-24 mt-6 font-semibold text-balance', lead ? 'text-3xl text-white sm:text-4xl' : 'text-xl text-ink']}>{item.title}</h3>
              <p class:list={['mt-3 leading-relaxed text-pretty', lead ? 'max-w-[40rem] text-lg text-white/75' : 'text-muted']}>{item.text}</p>
              <span class:list={['mt-auto inline-flex items-center gap-1.5 pt-6 text-sm font-semibold', lead ? 'text-orange-300' : 'text-orange-700 dark:text-orange-300']}>{linkFor(nowLinks, item.title)}<Glyph icon="arrow-right" class="size-4 transition group-hover:translate-x-1" /></span>
            </a>
          </li>
        );
      })}
    </ul>
  </section>

  {/*
    The founder block is laid out inline here rather than through VisionSection,
    which the home page uses. Only the layout differs: the home version is one
    narrow column, this one runs the statement full width with the photo beside
    the story. Every piece of content is still shared, so the two cannot drift
    apart -- the statement and story come from `vision` in the copy file, the
    photo from @images/team/vijay.jpg, and the name, role and LinkedIn from
    ORGANIZATION.founder. Change the words in those sources, never here, and
    keep the `.vision-frame` corner marks in step with VisionSection's.
  */}
  <div id="founder">
    <Box tone="dark"><section class="mx-auto max-w-[85rem] px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
      <p class="max-w-5xl text-[2rem] leading-[1.08] font-semibold tracking-tight text-balance text-white sm:text-[2.6rem] lg:text-[3.2rem]" data-words>{vision.statement}</p>
      <div class="mt-12 grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-16">
        <figure class="max-w-[18rem] sm:max-w-[22rem] lg:max-w-none" data-reveal>
          <div class="vision-photo relative aspect-[4/5] overflow-hidden rounded-[1.4rem] bg-white/5">
            <Picture
              src={founderPhoto}
              formats={['avif', 'webp']}
              widths={[320, 480, 640, 832]}
              sizes="(min-width: 1024px) 26rem, (min-width: 640px) 22rem, 18rem"
              alt={`${vision.person.name}, ${vision.person.role.toLowerCase()} of Buckleson`}
              loading="lazy"
              decoding="async"
              class="absolute inset-0 size-full object-cover object-top"
            />
            <span class="vision-frame" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
          </div>
          <figcaption class="mt-5">
            <p class="font-mono text-xs font-medium text-white">{vision.person.name}</p>
            <p class="mt-1 text-sm text-white/60">{vision.person.role}, Buckleson</p>
            <a href={ORGANIZATION.founder.linkedin} target="_blank" rel="noopener" class="mt-3 inline-flex items-center gap-2 text-sm font-semibold text-white/85 transition hover:text-white">
              <svg viewBox={socialIcons.linkedin.viewBox} class="size-4" fill="currentColor" aria-hidden="true">{socialIcons.linkedin.paths.map(d => <path d={d} />)}</svg>
              Connect on LinkedIn
            </a>
          </figcaption>
        </figure>
        <div class="grid content-start gap-8 text-lg leading-relaxed text-pretty text-white/75 sm:grid-cols-2 sm:gap-10" data-reveal>
          {vision.story.map(paragraph => <p>{paragraph}</p>)}
          <div class="sm:col-span-2"><PrimaryCTA title="Talk to us" url={localePath(locale, '/contact/')} /></div>
        </div>
      </div>
    </section></Box>
  </div>

  <Box><section class="mx-auto max-w-[85rem] px-4 py-20 sm:px-6 lg:px-8 lg:py-28" aria-labelledby="beyond-title">
    <SectionHead claim={copy.beyond.claim} payoff={copy.beyond.payoff} body={copy.beyond.body} id="beyond-title" />
    <ul class="mt-12 grid grid-cols-1 gap-x-12 border-t border-line md:grid-cols-2" data-reveal-group>
      {copy.beyond.items.map((item) => (
        <li class="border-b border-line" data-reveal-item>
          <a href={href(item.url)} class="beyond-card group grid grid-cols-[3rem_minmax(0,1fr)] gap-5 py-7">
            <span class="grid size-12 place-items-center rounded-2xl bg-card text-ink ring-1 ring-line transition duration-300 group-hover:bg-ink group-hover:text-ground group-hover:ring-ink"><Glyph ui={item.icon} class="size-6" /></span>
            <span class="block">
              <h3 id={headingSlug(item.title)} class="scroll-mt-24 text-xl font-semibold text-balance text-ink">{item.title}</h3>
              <span class="mt-2 block leading-relaxed text-pretty text-muted">{item.text}</span>
              <span class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-orange-700 dark:text-orange-300">{linkFor(beyondLinks, item.title)}<Glyph icon="arrow-right" class="size-4 transition group-hover:translate-x-1" /></span>
            </span>
          </a>
        </li>
      ))}
    </ul>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between" data-reveal>
      <p class="text-lg text-ink">{copy.beyond.note}</p>
      <a href={href(copy.beyond.more.url)} class="inline-flex items-center gap-2 font-semibold text-orange-700 underline-offset-4 hover:underline dark:text-orange-300">{copy.beyond.more.title}<Glyph icon="arrow-right" class="size-4" /></a>
    </div>
  </section></Box>

  <section class="mx-auto grid max-w-[85rem] grid-cols-1 gap-10 px-4 py-20 sm:px-6 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16 lg:px-8 lg:py-28" aria-labelledby="about-faq-title">
    <div>
      <h2 id="about-faq-title" class="text-4xl leading-[1.02] font-semibold text-ink sm:text-5xl"><span class="block">{copy.faq.claim}</span><span class="mark">{copy.faq.payoff}</span></h2>
    </div>
    <div class="divide-y divide-line border-y border-line">
      {copy.faq.items.map((item, index) => (
        <details class="group py-5" open={index === 0}>
          <summary class="flex cursor-pointer list-none items-start justify-between gap-6 text-lg font-semibold text-ink [&::-webkit-details-marker]:hidden">
            <span>{item.question}</span>
            <span class="mt-0.5 grid size-8 shrink-0 place-items-center rounded-full bg-card ring-1 ring-line transition duration-300 group-open:rotate-45"><Glyph icon="plus" class="size-4 text-ink" /></span>
          </summary>
          <p class="mt-3 max-w-[60ch] leading-relaxed text-pretty text-muted">{item.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <FinalCta {...t.home.finalCta} />
</MainLayout>

<script>
  // As each chapter crosses the middle of the screen, the left stage shows
  // its icon and name, and the other chapters dim a little.
  document.querySelectorAll<HTMLElement>('[data-story]').forEach(story => {
    const steps = [...story.querySelectorAll<HTMLElement>('[data-story-step]')];
    const chapters = [...story.querySelectorAll<HTMLElement>('[data-chapter]')];
    const pips = [...story.querySelectorAll<HTMLElement>('[data-pip]')];
    let current = -1;
    const show = (index: number) => {
      if (index === current) return;
      current = index;
      chapters.forEach((el, i) => el.toggleAttribute('data-on', i === index));
      pips.forEach((el, i) => el.toggleAttribute('data-on', i <= index));
      steps.forEach((el, i) => el.toggleAttribute('data-on', i === index));
    };
    story.classList.add('story-live');
    show(0);
    const observer = new IntersectionObserver(entries => {
      for (const entry of entries) if (entry.isIntersecting) show(steps.indexOf(entry.target as HTMLElement));
    }, { rootMargin: '-45% 0px -45% 0px' });
    steps.forEach(step => observer.observe(step));
  });
</script>

<style>
  /* The stage: chapters cross-fade and rise into place. */
  .story-chapter { opacity: 0; transform: translateY(14px); transition: opacity 450ms ease, transform 600ms cubic-bezier(0.22, 1, 0.36, 1); }
  .story-chapter[data-on] { opacity: 1; transform: none; }
  .story-pip { transition: background-color 400ms ease; }
  .story-pip[data-on] { background: var(--accent-500); }
  /* Chapters you are not reading step back (large screens, with the script). */
  @media (min-width: 1024px) {
    .story-live .story-step { opacity: 0.35; transition: opacity 400ms ease; }
    .story-live .story-step[data-on] { opacity: 1; }
    .story-live .story-step[data-on] .story-dot { background: var(--accent-600); color: #fff; }
  }
  :global(.dark) .story-live .story-step[data-on] .story-dot { background: var(--accent-500); }
  @media (prefers-reduced-motion: reduce) {
    .story-chapter, .story-pip, .story-live .story-step { transition: none; }
  }
  /* The timeline rail behind the dots. */
  .story-steps::before {
    content: '';
    position: absolute;
    left: calc(1.125rem - 1px);
    top: 0.5rem;
    bottom: 0.5rem;
    width: 2px;
    background: var(--line);
  }
  .now-card { transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1); }
  .now-card:hover { transform: translateY(-3px); }
  .now-card:focus-visible { outline: 3px solid var(--accent-500); outline-offset: 2px; }
  .beyond-card { transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1); }
  .beyond-card:hover { transform: translateX(4px); }
  .beyond-card:focus-visible { outline: 3px solid var(--accent-500); outline-offset: 2px; }
  /* The founder photo's thin inner frame, with a diagonal mark at each corner. */
  .vision-frame { position: absolute; inset: 0.8rem; border-radius: 1rem; box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.32); pointer-events: none; }
  .vision-frame i { position: absolute; width: 1.1rem; height: 1px; background: rgb(255 255 255 / 0.55); }
  .vision-frame i:nth-child(1) { left: 0.55rem; top: 0.95rem; transform: rotate(45deg); }
  .vision-frame i:nth-child(2) { right: 0.55rem; top: 0.95rem; transform: rotate(-45deg); }
  .vision-frame i:nth-child(3) { left: 0.55rem; bottom: 0.95rem; transform: rotate(-45deg); }
  .vision-frame i:nth-child(4) { right: 0.55rem; bottom: 0.95rem; transform: rotate(45deg); }
  @media (prefers-reduced-motion: reduce) { .beyond-card { transition: none; } .beyond-card:hover { transform: none; } }
</style>
