---
import SectionHead from '@components/home/SectionHead.astro';
import Glyph from '@components/ui/Glyph.astro';

/**
 * Build with us: a glass bento. Each tile is a large icon beside a small
 * animated figure of its own idea, a heading and one line. The detail is always
 * in the HTML; hover or focus swaps it in for the line, in the same space so
 * nothing shifts. Where there is no hover (touch) the line and the detail are
 * both shown. Figures animate transform and opacity only, and rest in a
 * meaningful static frame under reduced motion.
 */
interface Item {
  id: string;
  icon: string;
  size: string;
  title: string;
  line: string;
  detail: string;
}
interface Props {
  claim: string;
  payoff: string;
  body: string;
  items: Item[];
}

const { claim, payoff, body, items } = Astro.props;
const span: Record<string, string> = {
  lead: 'lg:col-span-2 lg:row-span-2',
  wide: 'lg:col-span-2',
  wide3: 'sm:col-span-2 lg:col-span-3',
  small: '',
};
---

<section class="mx-auto max-w-[85rem] px-4 py-20 sm:px-6 lg:px-8 lg:py-28" id="services" aria-labelledby="build-with-us">
  <SectionHead claim={claim} payoff={payoff} body={body} cta={{ title: 'All services', url: '/services/' }} id="build-with-us" />
  <div class="bento-stage relative mt-12 isolate rounded-[1.75rem] p-3 sm:p-4">
    <div class="grid gap-3 sm:grid-cols-2 sm:gap-4 lg:auto-rows-[minmax(13rem,auto)] lg:grid-cols-4" data-reveal-group>
      {items.map(item => (
        <article
          tabindex="0"
          aria-labelledby={`tile-${item.id}`}
          class:list={['tile glass-card group relative flex flex-col overflow-hidden rounded-[1.5rem] p-5 outline-none focus-visible:ring-2 focus-visible:ring-orange-600 sm:p-6', span[item.size] ?? '']}
          data-reveal-item
        >
          <div class="flex items-start justify-between gap-4">
            <span class="chip grid size-16 shrink-0 place-items-center rounded-2xl bg-orange-600/10 text-orange-600">
              <Glyph icon={item.icon} class="size-9" />
            </span>
            <svg
              viewBox="0 0 120 60"
              fill="currentColor"
              aria-hidden="true"
              class:list={['art text-orange-600', item.size === 'lead' ? 'h-24 w-48' : 'h-14 w-28 sm:h-16 sm:w-32']}
            >
              {item.id === 'observability' && (
                <>
                  <rect class="bar" style="--d:0s" x="4" y="6" width="84" height="7" rx="3.5" />
                  <rect class="bar" style="--d:.4s" x="22" y="19" width="70" height="7" rx="3.5" opacity=".7" />
                  <rect class="bar" style="--d:.8s" x="10" y="32" width="96" height="7" rx="3.5" />
                  <rect class="bar" style="--d:1.2s" x="40" y="45" width="60" height="7" rx="3.5" opacity=".7" />
                  <rect class="cursor" x="3" y="2" width="2.5" height="56" rx="1.2" />
                </>
              )}
              {item.id === 'training' && (
                <>
                  <rect class="rise" style="--d:0s" x="6" y="40" width="14" height="16" rx="4" opacity=".5" />
                  <rect class="rise" style="--d:.25s" x="30" y="32" width="14" height="24" rx="4" opacity=".6" />
                  <rect class="rise" style="--d:.5s" x="54" y="22" width="14" height="34" rx="4" opacity=".75" />
                  <rect class="rise" style="--d:.75s" x="78" y="12" width="14" height="44" rx="4" opacity=".9" />
                  <rect class="rise" style="--d:1s" x="102" y="3" width="14" height="53" rx="4" />
                </>
              )}
              {item.id === 'token-saving' && (
                <>
                  <rect class="tok keep k0" x="4" y="22" width="14" height="16" rx="4" />
                  <rect class="tok drop" style="--d:0s" x="24" y="22" width="14" height="16" rx="4" />
                  <rect class="tok keep k1" x="44" y="22" width="14" height="16" rx="4" />
                  <rect class="tok drop" style="--d:.2s" x="64" y="22" width="14" height="16" rx="4" />
                  <rect class="tok keep k2" x="84" y="22" width="14" height="16" rx="4" />
                  <rect class="tok drop" style="--d:.4s" x="104" y="22" width="14" height="16" rx="4" />
                </>
              )}
              {item.id === 'blockchain-security' && (
                <>
                  <rect class="blk" style="--d:0s" x="4" y="18" width="26" height="24" rx="6" />
                  <rect x="30" y="29" width="14" height="2" opacity=".4" />
                  <rect class="blk" style="--d:.5s" x="44" y="18" width="26" height="24" rx="6" />
                  <rect x="70" y="29" width="14" height="2" opacity=".4" />
                  <rect class="blk" style="--d:1s" x="84" y="18" width="26" height="24" rx="6" />
                </>
              )}
              {item.id === 'pii-masking' && (
                <>
                  <rect x="4" y="8" width="92" height="9" rx="4.5" opacity=".28" />
                  <rect x="4" y="25" width="70" height="9" rx="4.5" opacity=".28" />
                  <rect x="4" y="42" width="104" height="9" rx="4.5" opacity=".28" />
                  <rect class="cover" style="--d:0s" x="4" y="8" width="92" height="9" rx="4.5" />
                  <rect class="cover" style="--d:.45s" x="4" y="25" width="70" height="9" rx="4.5" />
                  <rect class="cover" style="--d:.9s" x="4" y="42" width="104" height="9" rx="4.5" />
                </>
              )}
              {item.id === 'zkps' && (
                <>
                  <circle class="ring" style="--d:0s" cx="60" cy="30" r="14" fill="none" stroke="currentColor" stroke-width="2" opacity=".35" />
                  <circle class="ring" style="--d:1.2s" cx="60" cy="30" r="14" fill="none" stroke="currentColor" stroke-width="2" opacity=".35" />
                  <circle cx="60" cy="30" r="7" />
                </>
              )}
            </svg>
          </div>
          <h3 id={`tile-${item.id}`} class:list={['mt-auto pt-6 font-semibold text-ink', item.size === 'lead' ? 'text-2xl lg:text-3xl' : 'text-lg']}>{item.title}</h3>
          <div class="tile-copy mt-2 text-ink/80">
            <p class="tile-line">{item.line}</p>
            <p class="tile-detail text-ink">{item.detail}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  /* A soft accent wash behind the tiles, so the frosted glass has something to blur. */
  .bento-stage {
    background:
      radial-gradient(40% 55% at 12% 20%, color-mix(in oklab, var(--accent-500) 22%, transparent), transparent),
      radial-gradient(35% 50% at 88% 85%, color-mix(in oklab, var(--accent-500) 16%, transparent), transparent);
  }
  /* Light glass comes from .glass-card (tint, blur, hairline, inner highlight). The tile itself never moves, so its blur never repaints. */
  :global(.dark) .tile {
    background: rgb(255 255 255 / 0.05);
    backdrop-filter: blur(18px) saturate(1.4);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.12), 0 0 0 1px rgb(255 255 255 / 0.1);
  }
  /* No hover means touch: drop the blur (cost) and use a firmer tint from the card token. */
  @media (hover: none) {
    .tile,
    :global(.dark) .tile {
      backdrop-filter: none;
      background: color-mix(in oklab, var(--card) 80%, transparent);
    }
  }
  /* Line and detail share one grid cell, so the tile never changes height. */
  .tile-copy { display: grid; }
  .tile-line, .tile-detail { grid-area: 1 / 1; transition: opacity 250ms ease; }
  .tile-detail { opacity: 0; }
  .tile:hover .tile-line, .tile:focus-within .tile-line { opacity: 0; }
  .tile:hover .tile-detail, .tile:focus-within .tile-detail { opacity: 1; }
  @media (hover: none) {
    .tile-copy { gap: 0.5rem; }
    .tile-line, .tile-detail { grid-area: auto; }
    .tile-detail { opacity: 1; }
    .tile:hover .tile-line, .tile:focus-within .tile-line { opacity: 1; }
  }

  /* Figures: the base styles are the static frame; motion is added on top of it. */
  .art { overflow: visible; }
  .art :is(.bar, .rise, .tok, .blk, .cover, .ring, .cursor) { transform-box: fill-box; }
  .art :is(.bar, .cover) { transform-origin: left center; }
  .art .rise { transform-origin: center bottom; }
  .art .ring { transform-origin: center; }
  .art .cursor { opacity: 0; }
  .art .tok.drop { opacity: 0.3; transform: scaleX(0.4); }
  .art .tok.k1 { --to: -20px; transform: translateX(-20px); }
  .art .tok.k2 { --to: -40px; transform: translateX(-40px); }
  .art .tok.k0 { --to: 0px; }

  @media (prefers-reduced-motion: no-preference) {
    .chip { transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1); }
    .tile:hover .chip, .tile:focus-within .chip { transform: scale(1.08); }
    .art .bar { animation: trace 4s ease-in-out var(--d) infinite; }
    .art .cursor { animation: scan 4s ease-in-out infinite; }
    .art .rise { animation: grow 3.2s ease-in-out var(--d) infinite alternate; }
    .art .tok.keep { animation: squeeze 4s ease-in-out infinite; }
    .art .tok.drop { animation: vanish 4s ease-in-out var(--d) infinite; }
    .art .blk { animation: link 3s ease-in-out var(--d) infinite; }
    .art .cover { animation: mask 4s ease-in-out var(--d) infinite; }
    .art .ring { animation: prove 2.4s ease-out var(--d) infinite; }
  }
  @media (prefers-reduced-motion: reduce) {
    .tile-line, .tile-detail { transition: none; }
  }
  @keyframes trace { 0% { transform: scaleX(0); } 35%, 85% { transform: scaleX(1); } 100% { transform: scaleX(0); } }
  @keyframes scan { 0% { transform: translateX(0); opacity: 0; } 10% { opacity: 0.8; } 45% { transform: translateX(104px); opacity: 0.8; } 55%, 100% { transform: translateX(104px); opacity: 0; } }
  @keyframes grow { from { transform: scaleY(0.3); } to { transform: scaleY(1); } }
  @keyframes squeeze { 0%, 25% { transform: translateX(0); } 55%, 85% { transform: translateX(var(--to)); } 100% { transform: translateX(0); } }
  @keyframes vanish { 0%, 25% { opacity: 0.9; transform: scaleX(1); } 50%, 85% { opacity: 0; transform: scaleX(0.2); } 100% { opacity: 0.9; transform: scaleX(1); } }
  @keyframes link { 0%, 100% { opacity: 0.35; } 30%, 70% { opacity: 1; } }
  @keyframes mask { 0% { transform: scaleX(0); } 30%, 80% { transform: scaleX(1); } 100% { transform: scaleX(0); } }
  @keyframes prove { 0% { transform: scale(0.8); opacity: 0.7; } 100% { transform: scale(2.4); opacity: 0; } }
</style>
