---
import SectionHead from '@components/home/SectionHead.astro';
import Glyph from '@components/ui/Glyph.astro';
import IsoFigure from '@components/ui/IsoFigure.astro';
import { localePath } from '@utils/locale';

/**
 * The detailed half of the "Build with us" bento: one stacking card for each
 * bento tile, each an Anatomy figure beside a dark panel with one sentence, a
 * few points and a read-more link into Resources. On wide screens the cards
 * stick under the header and each new card slides up over the last, which tips
 * back and shrinks a little. Narrower screens get a plain list.
 */
type FigureName = 'token-compactor' | 'trace-recorder' | 'feedback-wheel' | 'switch-yard' | 'pavii-gates';
interface Card {
  id: string;
  figure: string;
  title: string;
  text: string;
  points: string[];
  cta: { title: string; url: string };
}
interface Props {
  claim: string;
  payoff: string;
  body: string;
  cards: Card[];
}

const { claim, payoff, body, cards } = Astro.props;
---

<section class="mx-auto max-w-[85rem] px-4 py-20 sm:px-6 lg:px-8 lg:py-28" aria-labelledby="why-title">
  <SectionHead claim={claim} payoff={payoff} body={body} id="why-title" />

  <ol class="mt-14 grid gap-5 lg:block" data-stack>
    {cards.map(card => (
      <li class="stack-item" data-stack-card>
        <article class="stack-card grid overflow-hidden rounded-[2rem] ring-1 ring-line lg:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)]">
          <div class="stack-visual relative min-h-0 px-2 pt-4 sm:px-4">
            <IsoFigure name={card.figure as FigureName} tone="card" />
          </div>
          <div class="accent-warm m-3 flex flex-col rounded-[1.6rem] bg-sheet p-7 text-white sm:p-8 dark:bg-[#0a0a0a]">
            <h3 id={card.id} class="text-3xl leading-tight font-semibold text-balance sm:text-[2.2rem]">{card.title}</h3>
            <p class="mt-4 max-w-[40ch] leading-relaxed text-pretty text-white/80">{card.text}</p>
            <ul class="mt-5 mb-6 space-y-2.5 border-t border-white/12 pt-5 text-sm leading-snug text-white/70">
              {card.points.map(point => (
                <li class="flex gap-3"><span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-orange-300" aria-hidden="true"></span><span>{point}</span></li>
              ))}
            </ul>
            <a href={localePath('en', card.cta.url)} class="group mt-auto flex items-center justify-between rounded-full bg-white py-2 ps-6 pe-2 font-semibold text-[#0a0a0a] transition hover:bg-white/90">
              {card.cta.title}
              <span class="grid size-10 place-items-center rounded-full bg-[#0a0a0a] text-white transition group-hover:rotate-45"><Glyph icon="arrow-up-right" class="size-4" /></span>
            </a>
          </div>
        </article>
      </li>
    ))}
  </ol>
</section>

<style>
  .stack-card { background: var(--paper); }
  :global(.dark) .stack-card { background: #121212; }
  @media (min-width: 1024px) {
    .stack-item { position: sticky; top: 6rem; margin-bottom: 2.5rem; }
    .stack-item:last-child { margin-bottom: 0; }
    .stack-card { height: min(40rem, calc(100svh - 8rem)); transform-origin: 50% 0; will-change: transform; }
    .stack-visual { container: figbox / size; display: grid; align-items: center; }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // As each card slides up to its place, the one beneath tips back and
  // shrinks a little, like the stack in the reference.
  document.querySelectorAll<HTMLElement>('[data-stack]').forEach(stack => {
    const items = [...stack.querySelectorAll<HTMLElement>('[data-stack-card]')];
    const media = gsap.matchMedia();
    media.add('(min-width: 1024px) and (prefers-reduced-motion: no-preference)', () => {
      items.slice(0, -1).forEach((item, i) => {
        const card = item.querySelector<HTMLElement>('.stack-card')!;
        gsap.to(card, {
          scale: 0.92,
          rotate: -1.6,
          opacity: 0.75,
          ease: 'none',
          scrollTrigger: { trigger: items[i + 1], start: 'top bottom', end: 'top top+=96', scrub: true },
        });
      });
    });
  });
</script>
