---
import Glyph from '@components/ui/Glyph.astro';
import { BOOKING_URL } from '@data/constants';
import { headingSlug } from '@utils/utils';

/**
 * Closing call to action on a dark sheet. `tone` lets a product page keep it on its own surface:
 * `slab` is the last panel of an already-dark page, `surface` sits on the page's own ground.
 */
interface Props {
  claim: string;
  payoff: string;
  text: string;
  btn: string;
  email: string;
  id?: string;
  tone?: 'slab' | 'surface';
}

const { claim, payoff, text, btn, email, id, tone } = Astro.props;
const sheet = tone === undefined;
---

<section class:list={[sheet ? 'mt-3 px-2 pb-3 sm:px-3' : tone === 'slab' ? 'border-t border-line' : 'px-2 pb-3 sm:px-3']}>
  <div class:list={['relative isolate px-6 py-20 text-center sm:py-28', sheet ? 'on-sheet overflow-hidden rounded-[2rem] bg-sheet text-white' : 'text-ink']}>
    <h2 id={id ?? headingSlug(`${claim} ${payoff}`)} class="scroll-mt-24 mx-auto max-w-3xl text-4xl leading-[1.02] font-semibold sm:text-6xl" data-reveal>
      <span class="relative z-[1] block">{claim}</span>
      <span class="mark">{payoff}</span>
    </h2>
    <p class:list={['mx-auto mt-5 max-w-md text-pretty', sheet ? 'text-white/70' : 'text-muted']} data-reveal>{text}</p>
    <div class="mt-8 flex flex-col items-center gap-4" data-reveal>
      <a href={BOOKING_URL} class="cta-pill text-base"><span>{btn}</span><span class="cta-chip"><Glyph icon="arrow-up-right" class="size-3.5" /></span></a>
      <a href="mailto:vijay@buckleson.com" class:list={['text-sm', sheet ? 'text-white/60 hover:text-white' : 'text-muted hover:text-ink']}>{email}</a>
    </div>
  </div>
</section>
