---
import { headingSlug } from '@utils/utils';
import PrimaryCTA from '@components/ui/buttons/PrimaryCTA.astro';
import { localePath } from '@utils/locale';

/**
 * Section opener, after the reference grammar: a two-line headline whose second line is the payoff (highlighted), and a
 * short paragraph with an optional call to action beside it. Nothing sits above the headline: the founder removed every
 * eyebrow and counter on 2026-11-24 (Hallmark Floor rule 9).
 */
interface Props {
  claim: string;
  payoff: string;
  body?: string;
  cta?: { title: string; url: string };
  tone?: 'ground' | 'sheet';
  id?: string;
}

const { claim, payoff, body, cta, tone = 'ground', id } = Astro.props;
const onSheet = tone === 'sheet';
---

<div class="grid gap-8 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:items-end">
  <div>
    <h2 id={id ?? headingSlug(`${claim} ${payoff}`)} class:list={['scroll-mt-24 text-4xl leading-[1.02] font-semibold sm:text-5xl lg:text-[3.3rem]', onSheet ? 'text-white' : 'text-ink']} data-reveal>
      <span class="relative z-[1] block">{claim}</span>
      <span class="mark block w-fit">{payoff}</span>
    </h2>
  </div>
  {(body || cta) && (
    <div class="lg:pb-2" data-reveal>
      {body && <p class:list={['max-w-[44ch] text-lg text-pretty', onSheet ? 'text-white/80' : 'text-ink/80']}>{body}</p>}
      {cta && <div class="mt-5"><PrimaryCTA title={cta.title} url={localePath('en', cta.url)} /></div>}
    </div>
  )}
</div>
