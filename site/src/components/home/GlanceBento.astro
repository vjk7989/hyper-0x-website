---
import Glyph from '@components/ui/Glyph.astro';
import { brand, type BrandKey } from '@utils/glyphs';

/**
 * "At a glance": one plain statement, a bento grid of technology facts (four
 * counts of how the chain works, AI models checked, the egress gauge and
 * the private L2 for each customer) and the chains, exchanges and models we
 * work with.
 */
interface Props {
  statement: string;
  fact: { title: string; text: string };
  logosTitle: string;
}

const { statement, fact, logosTitle } = Astro.props;
const stats = [
  { count: 6, prefix: '', suffix: '', label: 'security gates on every agent call' },
  { count: 1, prefix: '', suffix: ' pass', label: 'to a final, ordered record' },
  { count: 4, prefix: '', suffix: '', label: 'layers of encryption' },
  { count: 3, prefix: '', suffix: '', label: 'ecosystems: EVM, Solana and Sui' },
];
const models = (['claude', 'gemini', 'openai', 'grok'] as const).map(key => brand(key));
const marquee: BrandKey[] = ['ethereum', 'bitcoin', 'solana', 'sui', 'tether', 'binance', 'coinbase', 'openai', 'claude', 'gemini', 'grok'];
const ticks = Array.from({ length: 48 }, (_, i) => i);
---

<section class="mx-auto max-w-[85rem] px-4 py-14 sm:px-6 lg:px-8 lg:py-20">
  <div>
    <p class="max-w-[48ch] text-xl leading-relaxed font-medium text-pretty text-ink sm:text-2xl" data-reveal>{statement}</p>

    <div class="mt-10 grid gap-3 md:grid-cols-2 lg:grid-cols-4">
      <div class="bento accent-warm rounded-[1.6rem] bg-sheet p-6 text-white md:col-span-2 lg:row-span-2" data-reveal>
        <dl class="grid grid-cols-2 gap-x-6 gap-y-8">
          {stats.map(stat => (
            <div class="flex flex-col-reverse justify-end">
              <dt class="mt-2 text-sm text-white/70">{stat.label}</dt>
              <dd class="font-display text-4xl font-semibold tabular-nums sm:text-5xl" data-count={stat.count} data-prefix={stat.prefix} data-suffix={stat.suffix}>{stat.prefix}{stat.count}{stat.suffix}</dd>
            </div>
          ))}
        </dl>
      </div>

      <div class="bento flex flex-col items-center justify-center gap-4 rounded-[1.6rem] border border-dashed border-ink/25 p-6 text-center" data-reveal>
        <div class="flex -space-x-2.5">
          {models.map(model => (
            <span class="grid size-12 place-items-center rounded-full bg-card ring-4 ring-card" title={model.title}>
              <span class="grid size-11 place-items-center rounded-full bg-card">
                {model.path ? (
                  <svg viewBox="0 0 24 24" class="size-6" style={`color:#${model.hex}`} aria-hidden="true"><path d={model.path} fill="currentColor" fill-rule={model.rule} /></svg>
                ) : (
                  <span class="text-sm font-extrabold" style={`color:#${model.hex}`}>{model.monogram}</span>
                )}
              </span>
            </span>
          ))}
        </div>
        <p class="text-sm text-ink"><span class="font-semibold">Any AI model</span>, checked by H0x-ADE</p>
      </div>

      <div class="bento glass-tint flex flex-col justify-center rounded-[1.6rem] p-6 lg:row-span-2" data-reveal>
        <div class="gauge relative mx-auto aspect-square w-40" data-gauge>
          <svg viewBox="0 0 200 200" class="absolute inset-0" aria-hidden="true">
            {ticks.map(i => {
              const a = (i / ticks.length) * Math.PI * 2 - Math.PI / 2;
              const r1 = 74, r2 = i % 4 === 0 ? 96 : 88;
              return <line class="tick" x1={100 + Math.cos(a) * r1} y1={100 + Math.sin(a) * r1} x2={100 + Math.cos(a) * r2} y2={100 + Math.sin(a) * r2} style={`--i:${i}`} />;
            })}
          </svg>
          <span class="absolute inset-0 m-auto grid size-16 place-items-center rounded-full bg-sheet text-white"><Glyph icon="lock-key" class="size-7" /></span>
        </div>
        <p class="mt-6 font-display text-xl font-semibold text-ink">Egress policy</p>
        <p class="mt-1 text-sm text-muted">What may leave your side, and where it may go, is decided before a call goes out.</p>
      </div>

      <div class="bento glass-tint rounded-[1.6rem] p-6" data-reveal>
        <div>
          <p class="font-display text-xl font-semibold text-ink">{fact.title}</p>
          <p class="mt-1 text-sm text-pretty text-muted">{fact.text}</p>
        </div>
      </div>
    </div>

    <div class="mt-10 flex flex-col gap-4 border-t border-line pt-6 md:flex-row md:items-center">
      <div class="marquee relative flex-1 overflow-hidden" aria-label={logosTitle}>
        <ul class="marquee-track flex w-max gap-10">
          {marquee.map(key => {
            const logo = brand(key);
            return (
              <li class="flex items-center gap-2 text-muted">
                <svg viewBox="0 0 24 24" class="size-5" aria-hidden="true"><path d={logo.path} fill="currentColor" fill-rule={logo.rule} /></svg>
                <span class="text-sm font-medium whitespace-nowrap">{logo.title}</span>
              </li>
            );
          })}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .bento { transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1); }
  @media (hover: hover) { .bento:hover { transform: translateY(-3px); } }
  .tick { stroke: color-mix(in oklab, var(--ink) 18%, transparent); stroke-width: 2.5; stroke-linecap: round; }
  .gauge.is-on .tick { animation: tick-on 2.4s cubic-bezier(0.22, 1, 0.36, 1) both; animation-delay: calc(var(--i) * 30ms); }
  @keyframes tick-on { 0% { stroke: color-mix(in oklab, var(--ink) 18%, transparent); } 40%, 100% { stroke: var(--accent-500); } }
  .marquee { mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent); }
  .marquee-track.is-cloned { animation: marquee 32s linear infinite; }
  .marquee:hover .marquee-track.is-cloned { animation-play-state: paused; }
  @keyframes marquee { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track { animation: none; }
    .gauge .tick { stroke: var(--accent-500); }
  }
</style>

<script>
  // The second copy exists only to loop the strip, so it is made here and never reaches the HTML crawlers read.
  document.querySelectorAll<HTMLElement>('.marquee-track').forEach(track => {
    [...track.children].forEach(li => { const copy = li.cloneNode(true) as HTMLElement; copy.setAttribute('aria-hidden', 'true'); track.append(copy); });
    track.classList.add('is-cloned');
  });
  document.querySelectorAll<HTMLElement>('[data-gauge]').forEach(gauge => {
    new IntersectionObserver(([entry], observer) => {
      if (!entry.isIntersecting) return;
      gauge.classList.add('is-on');
      observer.disconnect();
    }, { threshold: 0.4 }).observe(gauge);
  });
</script>
