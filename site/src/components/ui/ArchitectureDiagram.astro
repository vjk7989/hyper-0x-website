---
import { architecture as spec } from '@data/architecture';
import { glyph } from '@utils/glyphs';

/**
 * Static, theme-aware architecture diagram. Real <text> labels, so the words
 * are in the HTML for crawlers and screen readers. Colours come from
 * currentColor and the accent tokens, so both themes work with no hex.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;

const W = 700;
const H = 250;
const NW = 176;
const NH = 64;
const at = (id: string) => {
  const n = spec.nodes.find(node => node.id === id)!;
  return { x: 24 + n.col * 222, y: 30 + n.row * 120 };
};
/** Nodes sit on a grid, so every edge is a straight horizontal line. */
const line = (from: string, to: string) => {
  const a = at(from);
  const b = at(to);
  const y = a.y + NH / 2;
  return b.x > a.x ? `M${a.x + NW},${y} H${b.x}` : `M${a.x},${y} H${b.x + NW}`;
};
---

<svg viewBox={`0 0 ${W} ${H}`} class="ad block h-auto w-full" role="img" aria-label={spec.title}>
  <defs>
    <marker id="ad-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
      <path d="M0,0 L10,5 L0,10 z" fill="currentColor" opacity="0.4"></path>
    </marker>
  </defs>
  {spec.edges.map(([, from, to]) => (
    <path d={line(from, to)} fill="none" stroke="currentColor" stroke-opacity="0.3" stroke-width="2" marker-end="url(#ad-arrow)"></path>
  ))}
  {spec.nodes.map(node => {
    const { x, y } = at(node.id);
    const accent = node.tone === 'chain';
    return (
      <g transform={`translate(${x},${y})`} class:list={{ 'ad-chain': accent }}>
        <rect width={NW} height={NH} rx="14" class="ad-card"></rect>
        <svg x="20" y="20" width="24" height="24" viewBox="0 0 256 256" fill="currentColor" opacity="0.7" aria-hidden="true" set:html={glyph(node.icon!)}></svg>
        <text x="60" y="29" font-size="13.5" font-weight="650" fill="currentColor" class="font-display">{node.label}</text>
        <text x="60" y="46" font-size="11" fill="currentColor" fill-opacity="0.65">{node.sub}</text>
      </g>
    );
  })}
</svg>

<style>
  .ad { color: inherit; }
  .ad-card { fill: color-mix(in oklab, currentColor 4%, transparent); stroke: currentColor; stroke-opacity: 0.2; stroke-width: 1.5; }
  .ad-chain .ad-card { fill: color-mix(in oklab, var(--accent-500) 8%, transparent); stroke: var(--accent-500); stroke-opacity: 1; }
</style>
