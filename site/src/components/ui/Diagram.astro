---
import { Image } from 'astro:assets';
import ArchitectureDiagram from '@components/ui/ArchitectureDiagram.astro';
import { diagrams, type DiagramName } from '@data/diagrams';

/**
 * A framed architecture diagram that follows the site theme. Image diagrams
 * open full-size for zooming; the hyper0x diagram is inline SVG instead.
 */
interface Props {
  name: DiagramName;
  alt?: string;
  caption?: string;
  eager?: boolean;
  class?: string;
}

const { name, alt, caption, eager = false, class: className } = Astro.props;
const diagram = diagrams[name];
const image = 'light' in diagram ? diagram : undefined;
const label = alt ?? diagram.alt;
const loading = eager ? 'eager' : 'lazy';
---

<figure class:list={['diagram', className]}>
  <div class="overflow-hidden rounded-2xl bg-white shadow-[0_24px_60px_-28px_rgb(30_16_60/0.35)] ring-1 ring-neutral-900/10 dark:bg-[#0c0c0c] dark:shadow-[0_24px_60px_-28px_rgb(0_0_0/0.8)] dark:ring-white/10">
    {image ? (
      <>
        <a href={image.light.src} class="block dark:hidden" aria-label={`Open full-size diagram: ${label}`}>
          <Image src={image.light} alt={label} loading={loading} class="h-auto w-full" widths={[640, 1024, image.light.width]} sizes="(min-width: 1280px) 1200px, 100vw" />
        </a>
        <a href={image.dark.src} class="hidden dark:block" aria-label={`Open full-size diagram: ${label}`}>
          <Image src={image.dark} alt="" loading={loading} class="h-auto w-full" widths={[640, 1024, image.dark.width]} sizes="(min-width: 1280px) 1200px, 100vw" />
        </a>
      </>
    ) : (
      <div class="p-4 sm:p-6"><ArchitectureDiagram /></div>
    )}
  </div>
  {caption && image && (
    <figcaption class="mt-3 text-center text-sm text-muted">
      {caption}
    </figcaption>
  )}
</figure>
