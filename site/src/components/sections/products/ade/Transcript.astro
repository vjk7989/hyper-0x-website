---
import type { adePage } from '@data/product-pages/h0x-ade';

// ref: herdr.dev - prompt-to-result transcript; browser frame from kiloagent.framer.website
interface Props {
  transcript: typeof adePage.tokens.transcript;
}

const { transcript: t } = Astro.props;
const tagClass: Record<string, string> = {
  kept: 'bg-orange-950 text-orange-300',
  summarised: 'ring-1 ring-line text-ink/85',
  dropped: 'ring-1 ring-line text-muted line-through',
};
---

<figure class="rounded-3xl bg-card ring-1 ring-line" data-reveal="right">
  <figcaption class="sr-only">{t.caption}</figcaption>
  <div aria-hidden="true">
    <div class="flex items-center gap-2 border-b border-line px-5 py-3">
      <span class="size-2.5 rounded-full bg-line"></span><span class="size-2.5 rounded-full bg-line"></span><span class="size-2.5 rounded-full bg-line"></span>
      <span class="ms-3 font-mono text-xs text-muted">{t.title}</span>
    </div>
    <ol class="space-y-3 p-5 font-mono text-[0.8rem] sm:p-7" data-reveal-group>
      <li class="text-ink" data-reveal-item><span class="text-orange-400">&gt;</span> {t.instruction}</li>
      {t.lines.map(line => (
        <li class="flex flex-wrap items-center justify-between gap-2 text-muted" data-reveal-item>
          <span>{line.tool}</span>
          <span class={`rounded-full px-2.5 py-0.5 text-[0.7rem] ${tagClass[line.tag]}`}>{line.tag}</span>
        </li>
      ))}
      <li class="border-t border-line pt-3 text-ink" data-reveal-item>{t.result}</li>
    </ol>
  </div>
</figure>
