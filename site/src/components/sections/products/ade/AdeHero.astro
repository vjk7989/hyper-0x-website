---
import Glyph from '@components/ui/Glyph.astro';
import ProofStrip from '@components/ui/ProofStrip.astro';
import { localePath } from '@utils/locale';
import AdeMosaic from './AdeMosaic.astro';
import type { adePage } from '@data/product-pages/h0x-ade';

// ref: herdr.dev - left-aligned hero, two-line headline with muted second line, tilted window mosaic
interface Props {
  page: typeof adePage;
  cta: { title: string; url: string };
  docs: { title: string; url: string };
}

const { page, cta, docs } = Astro.props;
const h = page.hero;
---

<section aria-labelledby="h0x-ade" class="relative isolate overflow-hidden">
  <div aria-hidden="true" class="ade-dots pointer-events-none absolute inset-0 -z-10"></div>
  <div class="mx-auto grid min-h-[calc(100svh-4.5rem)] max-w-[85rem] items-center gap-8 px-4 py-14 sm:px-6 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-6 lg:px-8 lg:py-20">
    <div class="ade-rise relative z-[1]">
      <h1 id="h0x-ade" class="text-[2.6rem] leading-[0.98] font-semibold sm:text-6xl lg:text-7xl">
        <span class="block font-mono text-sm font-normal tracking-normal text-muted">{h.kicker}</span>
        <span class="mt-4 block text-ink">{h.line1}</span>
        <span class="block text-muted">{h.line2}</span>
      </h1>
      <p class="mt-6 max-w-[34rem] text-lg text-pretty text-muted">{h.sub}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={cta.url} class="cta-pill"><span>{cta.title}</span><span class="cta-chip"><Glyph icon="arrow-up-right" class="size-3.5" /></span></a>
        <a href={localePath('en', docs.url)} class="cta-ghost text-ink">{h.docs}</a>
      </div>
      <ul class="mt-8 flex flex-wrap gap-2">
        {h.models.map(model => <li class="rounded-full bg-card px-3 py-1.5 text-xs text-ink/85 ring-1 ring-line">{model}</li>)}
      </ul>
      <ProofStrip items={page.proof} />
    </div>
    <div class="ade-mosaic-in h-[clamp(11rem,30svh,16rem)] overflow-hidden lg:h-auto lg:overflow-visible">
      <AdeMosaic />
    </div>
  </div>
</section>

<style>
  .ade-dots {
    background: radial-gradient(circle at 1px 1px, color-mix(in oklab, var(--ink) 13%, transparent) 1px, transparent 1.2px) 0 0 / 22px 22px;
    mask-image: linear-gradient(100deg, transparent 10%, #000 70%);
  }
  @media (prefers-reduced-motion: no-preference) {
    .ade-rise { animation: ade-rise 600ms cubic-bezier(0.22, 1, 0.36, 1) both; }
    .ade-mosaic-in { animation: ade-in-right 900ms cubic-bezier(0.22, 1, 0.36, 1) both; }
    @keyframes ade-rise { from { opacity: 0; transform: translateY(12px); } }
    @keyframes ade-in-right { from { opacity: 0; transform: translateX(40px); } }
  }
</style>
