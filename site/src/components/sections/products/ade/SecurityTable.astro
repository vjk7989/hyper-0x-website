---
import SectionHead from '@components/home/SectionHead.astro';
import { threats } from '@data/threats';
import type { adePage } from '@data/product-pages/h0x-ade';

// ref: buckleson.com - house table and card style; content is ours
// Grouping and the on-chain column come from the `chain` field of threats.ts (read-only here).
interface Props {
  page: typeof adePage;
}

const s = Astro.props.page.security;
const onChain = 'bg-orange-950 text-orange-200';
const offChain = 'ring-1 ring-line text-muted';
---

<section aria-labelledby={s.id} class="mx-auto max-w-[85rem] px-4 py-14 sm:px-6 lg:px-8 lg:py-20">
  <SectionHead index="3" id={s.id} label={s.label} claim={s.claim} payoff={s.payoff} />
  <div class="mt-10 overflow-x-auto rounded-3xl bg-card ring-1 ring-line" data-reveal>
    <table class="w-full min-w-[40rem] border-collapse text-left text-sm">
      <caption class="sr-only">{s.caption}</caption>
      <thead>
        <tr class="border-b border-line text-muted">
          {s.columns.map(col => <th scope="col" class="px-6 py-4 font-medium">{col}</th>)}
        </tr>
      </thead>
      {s.groups.map(group => (
        <tbody>
          <tr>
            <th scope="rowgroup" colspan="3" class="bg-ground/60 px-6 py-3 font-mono text-xs font-normal text-muted">{group.title}</th>
          </tr>
          {threats.filter(threat => threat.chain === group.chain).map(threat => (
            <tr class="border-t border-line align-top">
              <th scope="row" class="px-6 py-4 font-medium text-ink">{s.rows[threat.title].condition}</th>
              <td class="px-6 py-4 text-ink/80">{s.rows[threat.title].mechanism}</td>
              <td class="px-6 py-4"><span class:list={['inline-block rounded-full px-3 py-1 text-xs whitespace-nowrap', group.chain === 'yes' ? onChain : offChain]}>{group.where}</span></td>
            </tr>
          ))}
        </tbody>
      ))}
    </table>
  </div>

  <div class="mt-3 rounded-3xl p-7 ring-1 ring-line" data-reveal>
    <h3 id={s.limits.id} class="text-2xl font-semibold text-ink">{s.limits.title}</h3>
    <p class="mt-2 max-w-[60ch] text-muted">{s.limits.text}</p>
    <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {s.limits.items.map(item => <li class="rounded-2xl bg-card px-4 py-3 font-medium text-ink ring-1 ring-line">{item}</li>)}
    </ul>
  </div>
</section>
