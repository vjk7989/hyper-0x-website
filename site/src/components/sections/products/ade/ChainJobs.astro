---
import SectionHead from '@components/home/SectionHead.astro';
import type { adePage } from '@data/product-pages/h0x-ade';

// ref: buckleson.com - house card style; no counterpart on the references, ours to write
interface Props {
  page: typeof adePage;
}

const c = Astro.props.page.chain;
// 96px inline SVGs: a rule sheet, a key inside a box, a slip linked to the previous slip.
const drawings = [
  '<rect x="26" y="10" width="44" height="76" rx="6"/><path d="M36 28h24M36 40h24M36 52h16"/>',
  '<rect x="18" y="34" width="60" height="44" rx="6"/><circle cx="40" cy="56" r="7"/><path d="M47 56h18M60 56v8"/>',
  '<rect x="8" y="14" width="40" height="30" rx="5"/><rect x="48" y="52" width="40" height="30" rx="5"/><path d="M28 44v10h20"/>',
];
---

<section aria-labelledby={c.id} class="mx-auto max-w-[85rem] px-4 py-14 sm:px-6 lg:px-8 lg:py-20">
  <SectionHead id={c.id} claim={c.claim} payoff={c.payoff} />
  <div class="relative mt-10">
    <div aria-hidden="true" class="absolute start-[0.45rem] top-2 bottom-2 w-px bg-line lg:start-0 lg:end-0 lg:bottom-auto lg:h-px lg:w-auto"></div>
    <ol class="grid gap-3 ps-8 lg:grid-cols-3 lg:ps-0 lg:pt-8" data-reveal-group>
      {c.jobs.map((job, index) => (
        <li class="relative rounded-3xl bg-card p-7 ring-1 ring-line" data-reveal-item>
          <span aria-hidden="true" class="ade-dot absolute -start-[2.05rem] top-8 size-3 rounded-full bg-orange-400 lg:start-7 lg:-top-[1.45rem]" style={`--i:${index}`}></span>
          <p class="font-mono text-sm text-muted">{job.step}</p>
          <h3 id={job.id} class="mt-3 text-2xl font-semibold text-ink">{job.title}</h3>
          <p class="mt-3 text-muted">{job.text}</p>
          <figure class="mt-6">
            <figcaption class="sr-only">{job.caption}</figcaption>
            <svg aria-hidden="true" viewBox="0 0 96 96" class="size-24 text-orange-400" fill="none" stroke="currentColor" stroke-width="2" set:html={drawings[index]} />
          </figure>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .ade-dot { animation: ade-fill 600ms ease-out both; animation-delay: calc(var(--i) * 300ms); }
    @keyframes ade-fill { from { transform: scale(0); } }
  }
</style>
