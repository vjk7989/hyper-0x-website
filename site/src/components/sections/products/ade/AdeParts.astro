---
import SectionHead from '@components/home/SectionHead.astro';
import IsoFigure from '@components/ui/IsoFigure.astro';
import type { adePage } from '@data/product-pages/h0x-ade';

// ref: kiloagent.framer.website - four-card feature block; figure is ours (anatomy skill)
// Figure: ade-path. One call rides a rail through the four parts, numbered to match the cards.
interface Props {
  page: typeof adePage;
}

const p = Astro.props.page.parts;
---

<section aria-labelledby={p.id} class="mx-auto max-w-[85rem] px-4 py-14 sm:px-6 lg:px-8 lg:py-20">
  <SectionHead id={p.id} label={p.label} claim={p.claim} payoff={p.payoff} body={p.body} />
  <div class="mt-10 rounded-[2rem] bg-card p-3 ring-1 ring-line sm:p-5" data-reveal>
    <IsoFigure name="ade-path" tone="sheet" />
  </div>
  <ol class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4" data-reveal-group>
    {p.cards.map((card, index) => (
      <li data-reveal-item>
        <a href={card.href} class="block h-full rounded-3xl bg-card p-6 ring-1 ring-line transition hover:-translate-y-0.5 hover:ring-orange-400">
          <span class="grid size-8 place-items-center rounded-full font-mono text-sm text-orange-400 ring-1 ring-line">{index + 1}</span>
          <h3 id={card.id} class="mt-5 text-2xl font-semibold text-ink">{card.title}</h3>
          <p class="mt-2 text-muted">{card.text}</p>
        </a>
      </li>
    ))}
  </ol>
</section>
