---
// ref: necta.framer.website - light left-aligned hero, gradient wash, phone on the right
import Glyph from '@components/ui/Glyph.astro';
import WalletPhone from './WalletPhone.astro';
import { walletPage } from '@data/product-pages/hyper-wallet';
import { localePath } from '@utils/locale';

interface Props {
  cta: { title: string; url: string };
  docsUrl: string;
}

const { cta, docsUrl } = Astro.props;
const h = walletPage.hero;
---

<section class="wallet-hero relative isolate mx-2 min-h-[calc(100svh-4.5rem)] overflow-hidden rounded-[2rem] sm:mx-3" aria-labelledby="hyper-wallet">
  <div class="mx-auto grid min-h-[calc(100svh-4.5rem)] max-w-[85rem] grid-cols-1 items-center gap-8 px-4 pt-12 sm:px-6 lg:grid-cols-[minmax(0,6fr)_minmax(0,5fr)] lg:px-8 lg:py-16">
    <div class="wallet-rise">
      <h1 id="hyper-wallet" class="text-[2.6rem] leading-[0.98] font-semibold sm:text-6xl lg:text-7xl">
        <span class="block font-mono text-sm font-normal text-muted">{h.kicker}</span>
        <span class="mt-3 block text-ink">{h.line1}</span>
        <span class="mark block">{h.line2}</span>
      </h1>
      <p class="mt-6 max-w-[34rem] text-lg text-pretty text-muted">{h.sub}</p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href={cta.url} class="cta-pill text-base"><span>{cta.title}</span><span class="cta-chip"><Glyph icon="arrow-up-right" class="size-3.5" /></span></a>
        <a href={localePath('en', docsUrl)} class="cta-ghost">{h.docs}</a>
      </div>
      <ul class="mt-8 flex flex-wrap gap-2">
        {h.chains.map(c => (
          <li class="inline-flex items-center gap-1.5 rounded-full bg-card px-3 py-1.5 text-xs ring-1 ring-line">
            {c.brand && <Glyph brand={c.brand} class="size-3.5" />}{c.name}
          </li>
        ))}
      </ul>
    </div>
    <div class="wallet-enter max-h-[42svh] overflow-hidden lg:max-h-none lg:overflow-visible">
      <div class="wallet-float"><WalletPhone screen="portfolio" class="rotate-[6deg]" /></div>
    </div>
  </div>
</section>

<style>
  .wallet-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(60% 60% at 85% 10%, color-mix(in oklab, var(--accent-300) 26%, transparent), transparent),
      radial-gradient(60% 60% at 60% 90%, color-mix(in oklab, var(--color-emerald-200) 40%, transparent), transparent),
      radial-gradient(60% 60% at 10% 30%, color-mix(in oklab, var(--accent-100) 70%, transparent), transparent);
  }
  :global(.dark) .wallet-hero::before { opacity: 0.35; }
  @media (prefers-reduced-motion: no-preference) {
    .wallet-rise { animation: wallet-rise 600ms cubic-bezier(0.22, 1, 0.36, 1) both; }
    .wallet-enter { animation: wallet-in 900ms cubic-bezier(0.22, 1, 0.36, 1) both; }
    .wallet-float { animation: wallet-float 7s ease-in-out 900ms infinite alternate; }
    @keyframes wallet-rise { from { opacity: 0; transform: translateY(12px); } }
    @keyframes wallet-in { from { opacity: 0; transform: translateX(40px); } }
    @keyframes wallet-float { from { transform: translateY(-8px); } to { transform: translateY(8px); } }
  }
</style>
