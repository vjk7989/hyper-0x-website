---
// ref: necta.framer.website - large rounded cards pairing a phone with a heading and two lines
import SectionHead from '@components/home/SectionHead.astro';
import WalletPhone from './WalletPhone.astro';
import { walletPage } from '@data/product-pages/hyper-wallet';

const j = walletPage.jobs;
const layout: Record<string, { span: string; reveal?: 'left' | 'right'; wide?: boolean }> = {
  hold: { span: 'lg:col-span-7', reveal: 'left' },
  swap: { span: 'lg:col-span-5', reveal: 'right' },
  trade: { span: 'lg:col-span-12', wide: true },
};
---

<section class="mx-auto max-w-[85rem] px-4 py-14 sm:px-6 lg:px-8 lg:py-20" aria-labelledby={j.id}>
  <SectionHead claim={j.claim} payoff={j.payoff} id={j.id} />
  <div class="glass mt-10 rounded-[2rem] p-3">
    <ul class="grid grid-cols-1 gap-3 lg:grid-cols-12" data-reveal-group>
      {j.items.map(item => {
        const l = layout[item.id];
        return (
          <li
            class:list={['relative flex min-h-[30rem] flex-col overflow-hidden rounded-3xl bg-card shadow-[0_18px_38px_-28px_rgb(0_0_0/0.25)]', l.span, l.wide && 'lg:grid lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:items-center lg:gap-6']}
            data-reveal-item
            data-reveal={l.reveal}
          >
            <div class="p-7 lg:p-9">
              <h3 id={item.id} class="text-2xl font-semibold text-ink">{item.title}</h3>
              <p class="mt-2 max-w-[40ch] text-pretty text-muted">{item.text}</p>
            </div>
            <div class:list={['mt-auto px-6', l.wide ? 'max-h-[24rem] overflow-hidden' : 'translate-y-12']}>
              <WalletPhone screen={item.screen} />
            </div>
          </li>
        );
      })}
    </ul>
  </div>
</section>
