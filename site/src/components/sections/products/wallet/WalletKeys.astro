---
// ref: necta.framer.website - whitespace and soft card; content is ours
import SectionHead from '@components/home/SectionHead.astro';
import { walletPage } from '@data/product-pages/hyper-wallet';

const k = walletPage.keys;
---

<section class="mx-auto max-w-[85rem] px-4 py-14 sm:px-6 lg:px-8 lg:py-20" aria-labelledby={k.id}>
  <div class="grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:items-center">
    <div class="[&>div]:block [&>div]:gap-6">
      <SectionHead index={k.index} label={k.label} claim={k.claim} payoff={k.payoff} body={k.body} id={k.id} />
    </div>
    <div class="glass-card rounded-3xl p-7 sm:p-9" data-reveal="right">
      <dl class="divide-y divide-line">
        {k.rows.map(r => (
          <div class="py-5 first:pt-0 last:pb-0 sm:grid sm:grid-cols-[minmax(0,2fr)_minmax(0,5fr)] sm:gap-6">
            <dt class="font-semibold text-ink">{r.term}</dt>
            <dd class="mt-1 text-pretty text-muted sm:mt-0">{r.text}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>
