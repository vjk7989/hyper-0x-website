---
// ref: kiloagent.framer.website - heading + three checklist rows + mockup split
import SectionHead from '@components/home/SectionHead.astro';
import Glyph from '@components/ui/Glyph.astro';
import WalletPhone from './WalletPhone.astro';
import { BOOKING_URL } from '@data/constants';
import { walletPage } from '@data/product-pages/hyper-wallet';

const s = walletPage.sdk;
---

<section class="mx-auto max-w-[85rem] px-4 py-14 sm:px-6 lg:px-8 lg:py-20" aria-labelledby={s.id}>
  <div class="glass grid grid-cols-1 gap-10 rounded-[2rem] p-8 lg:grid-cols-2 lg:items-center lg:p-14">
    <div>
      <SectionHead index={s.index} label={s.label} claim={s.claim} payoff={s.payoff} body={s.body} id={s.id} />
      <ul class="mt-8 space-y-4" data-reveal-group>
        {s.rows.map(r => (
          <li class="flex gap-3" data-reveal-item>
            <Glyph icon="check-circle" class="mt-0.5 size-5 shrink-0 text-orange-600" />
            <p class="text-pretty text-muted"><strong class="font-semibold text-ink">{r.title}.</strong> {r.text}</p>
          </li>
        ))}
      </ul>
      <div class="mt-8"><a href={BOOKING_URL} class="cta-ghost">{s.cta}</a></div>
    </div>
    <div class="sdk-fan relative flex items-center justify-center" data-reveal="right">
      <div class="sdk-a hidden sm:block"><WalletPhone screen="brand" accent={300} class="w-[clamp(9rem,13vw,12rem)]" /></div>
      <div class="sdk-b relative z-10 sm:-mx-8"><WalletPhone screen="brand" accent={500} class="w-[clamp(9rem,13vw,12rem)]" /></div>
      <div class="sdk-c hidden sm:block"><WalletPhone screen="brand" accent={700} class="w-[clamp(9rem,13vw,12rem)]" /></div>
    </div>
  </div>
</section>

<style>
  @media (prefers-reduced-motion: no-preference) {
    :global(.reveal-ready) .sdk-fan:not(:global(.is-revealed)) .sdk-a { transform: translateX(12px); }
    :global(.reveal-ready) .sdk-fan:not(:global(.is-revealed)) .sdk-c { transform: translateX(-12px); }
    .sdk-a, .sdk-c { transition: transform 700ms cubic-bezier(0.22, 1, 0.36, 1); }
  }
</style>
